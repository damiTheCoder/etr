# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# Reasoning Model Configuration
# When set, enables streaming reasoning panel (Cursor/Claude/Devin style)
# Examples: anthropic/claude-3.5-sonnet, openai/o1-mini, deepseek/deepseek-r1, nex-agi/nex-n2.5-pro:free
AI_REASONING_MODEL=anthropic/claude-3.5-sonnet
AI_REASONING_AUTO_COLLAPSE=true
AI_REASONING_AUTO_COLLAPSE_DELAY_MS=1000

# PaddleOCR Configuration
# Optional: Set token for cloud API fallback when local PaddleOCR is unavailable
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_API_URL=https://aistudio.baidu.com/paddleocr/api/v1/ocr

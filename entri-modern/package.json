{
  "name": "entri-modern",
  "version": "0.1.0",
  "description": "Modern rebuild of Entri - Double-entry accounting",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "feather-icons": "^4.29.2",
    "luxon": "^3.5.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.0"
  },
  "build": {
    "appId": "io.entri.modern",
    "productName": "Entri Modern",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}

{
  "buildCommand": "cd entri-modern/frontend && npm install && npm run build",
  "outputDirectory": "entri-modern/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
